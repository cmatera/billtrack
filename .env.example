# Copy this file to .env and fill in your own key before running docker compose up.

# Port the app listens on inside the container (and the host port mapping in docker-compose.yml).
PORT=3000

# Required for the "Upload bill schedule" feature. Get a key at https://console.anthropic.com/
# Without this set, the app still runs and shows the saved ledger, but uploads are disabled.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used to read PDF pages. Defaults to a current Sonnet alias.
# See https://docs.claude.com/en/docs/about-claude/models for current model ids.
ANTHROPIC_MODEL=claude-sonnet-4-5
